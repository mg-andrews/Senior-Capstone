// Uses FreeRTOS to schedule serial input, heart rate, pressure simulation, and stepper motor update tasks

// Arduino IDE
// Windows 11
// board: esp32s3

#include <stdlib.h>
#include <math.h>
#include <TMCStepper.h>
#include <FastAccelStepper.h>

// Define pins
#define POT_PIN 10
#define V_PLUS 39
#define BUTTON_PIN 38
#define VIO_PIN 15

#define EN_PIN   16
#define STEP_PIN 17
#define DIR_PIN  18

#define UART_TX  5
#define UART_RX  6

#define HRLED 36

// Cuff simulation param init
float cuffPressure = 0.0f;
float outputPressure = 0.0f;
float tau = 5.0f;     // seconds (default)

volatile float pulseAmplitude = 5.0f;   // small bump
volatile float pulseTime = 0.0f;
volatile bool pulseActive = false;

float systole = 120.0f;
float diastole = 80.0f;

// Heart rate queue and timer init
QueueHandle_t hr_queue;
static const uint8_t hr_queue_len = 5;
TimerHandle_t heartbeatTimer;
TimerHandle_t LEDOffTimer;

int currentHR = 60;

// Motor init
const int microstep = 32;
const float full_steps = 200.0;
const float steps_per_rev = microstep * full_steps;
const int deadband = 2; // In steps

#define R_SENSE 0.11f
TMC2209Stepper driver(&Serial1, R_SENSE, 0b00);

FastAccelStepperEngine engine = FastAccelStepperEngine();
FastAccelStepper *stepper = NULL;

QueueHandle_t motor_queue;
static const uint8_t motor_queue_len = 1; // Keep 1 so motor always follows latest position update

// Task handles
TaskHandle_t MotorHandle = NULL;
TaskHandle_t HRHandle = NULL;
TaskHandle_t CuffHandle = NULL;
TaskHandle_t SerialHandle = NULL;

//--------------------------------------------------------------------------------------------------
// Callbacks

// Heartbeat timer callback
void heartbeatCallback(TimerHandle_t xTimer) {
  digitalWrite(HRLED, HIGH);

  pulseActive = true;
  pulseTime = 0.0f;

  xTimerStart(LEDOffTimer, 0);
}

//--------------------------------------------------------------------------------------------------
// Tasks

// Task: Wait for serial heart rate input and put in queue
void SerialTask(void *parameter) {

  String inputString = "";

  for(;;) {

    while (Serial.available() > 0) {
      char c = Serial.read();

      if (c == '\n') {
        int newHR = inputString.toInt();

        if (newHR > 0 && newHR < 220) {
          Serial.print("Queued HR: ");
          Serial.println(newHR);
          xQueueSend(hr_queue, &newHR, portMAX_DELAY);
        } else {
          Serial.println("Invalid HR selection: HR must be between 0 and 220");
        }

        inputString = "";
      }
      else {
        inputString += c;
      }
    }

    vTaskDelay(pdMS_TO_TICKS(10));
  }
}

// Task: Updates HR
void HRTask(void *parameter) {
  int newHR;

  for(;;) {
    // Block until new HR arrives in queue
    if (xQueueReceive(hr_queue, &newHR, portMAX_DELAY) == pdTRUE) {
      currentHR = newHR;

      int halfPeriod = (60000 / currentHR);

      // Change timer period to half of HR --> LED changes state twice per heartbeat
      xTimerChangePeriod(
        heartbeatTimer,
        pdMS_TO_TICKS(halfPeriod),
        portMAX_DELAY
      );

      Serial.print("HR Updated: ");
      Serial.println(currentHR);
    }
  }
}

// Task: Update cuff pressure model
void CuffTask(void *parameter) {
  const float dt = 0.005f;   // 5 ms --> 200 Hz update
  TickType_t lastWakeTime = xTaskGetTickCount();

  for(;;) {
    // Read potentiometer
    int potValue = analogRead(POT_PIN);

    // Map to tau range (e.g. 1s to 15s)
    tau = 1.0f + (potValue / 4095.0f) * 14.0f;

    // Read button to input pressure in system
    if (!digitalRead(BUTTON_PIN)) {
      cuffPressure += 50.0f * dt;   // Cuff inflation rate
      if (cuffPressure > 360.0f)
        cuffPressure = 360.0f;
    }

    // Exponential decay model
    cuffPressure *= expf(-dt / tau);


      if(pulseActive) {
          pulseTime += dt;

          float sigma = 0.05f;  // pulse width (~50 ms)
          float pulse = pulseAmplitude * expf(-(pulseTime * pulseTime) / (2 * sigma * sigma));

          outputPressure = cuffPressure + pulse;

          if (pulseTime > 0.3f)  // end pulse after 300ms
              pulseActive = false;
      } else {
        outputPressure = cuffPressure;
      }
    

    // Clamp small values
    if (outputPressure < 0.1f)
      outputPressure = 0.0f;

    xQueueOverwrite(motor_queue, &outputPressure);

    vTaskDelayUntil(&lastWakeTime, pdMS_TO_TICKS(dt * 1000));
  }
}

// Task: Update stepper position based on cuffPressure
void MotorTask(void *parameter) {
  float cuffPressure;
  int lastPosition = 0;

  for(;;) {
    if (xQueueReceive(motor_queue, &cuffPressure, portMAX_DELAY) == pdTRUE) {
      // Convert pressure to motor position
      int targetPosition = (int)((cuffPressure / 360.0f) * steps_per_rev);

      if (abs(targetPosition - lastPosition) > deadband) {
        stepper->moveTo(targetPosition);
        lastPosition = targetPosition;
      }
    }
  }
}

//-------------------------------------------------------------------------
// Setup

void setup() {
  
  Serial.begin(115200);
  delay(300 / portTICK_PERIOD_MS);

  // Cuff pressure setup
  pinMode(V_PLUS, OUTPUT);
  pinMode(VIO_PIN, OUTPUT);
  pinMode(POT_PIN, INPUT);
  pinMode(BUTTON_PIN, INPUT_PULLUP);

  pinMode(HRLED, OUTPUT);

  digitalWrite(V_PLUS, HIGH); // Sets input of pot to 3.3V
  digitalWrite(VIO_PIN, HIGH); // Sets input to VIO on driver to 3.3V

  // Motor driver setup
  pinMode(EN_PIN, OUTPUT);
  pinMode(STEP_PIN, OUTPUT);
  pinMode(DIR_PIN, OUTPUT);

  digitalWrite(EN_PIN, HIGH); // Disable driver for config
  digitalWrite(DIR_PIN, HIGH); // LOW: CCW

  Serial1.begin(115200, SERIAL_8N1, UART_RX, UART_TX);
  delay(100);

  driver.begin();
  driver.toff(4);
  driver.blank_time(24);
  driver.internal_Rsense(false);
  driver.I_scale_analog(false);
  driver.mstep_reg_select(true);
  driver.microsteps(microstep);

  driver.en_spreadCycle(false);   // stable torque
  driver.TPWMTHRS(250);            // disable StealthChop
  driver.semin(0);               // disable CoolStep
  driver.rms_current(150);       // Max 0.15A RMS
  driver.hold_multiplier(0.2);   // Reduce idle heat & noise

  driver.pdn_disable(true);

  // Motor engine setup
  engine.init();
  stepper = engine.stepperConnectToPin(STEP_PIN);
  stepper->setDirectionPin(DIR_PIN);
  stepper->setEnablePin(EN_PIN);
  stepper->setAutoEnable(false);  // This sets the enable pin and turns the TMC2209 on/off atomatically

  /*
  stepper->setSpeedInHz(set_vel);
  stepper->setAcceleration(set_accel);
  */

  digitalWrite(EN_PIN, LOW); // Enable driver

  // Check UART works
  Serial.print("TMC version: 0x");
  Serial.println(driver.version(), HEX);
  Serial.print("Current readback: ");
  Serial.println(driver.rms_current());

  stepper->setSpeedInHz(2000);
  stepper->setAcceleration(5000);

  // Input messages
  Serial.println("Input heart rate by typing '[BPM]/n'");

  // Create queues
  hr_queue = xQueueCreate(hr_queue_len, sizeof(int));
  motor_queue = xQueueCreate(motor_queue_len, sizeof(float));

  // Create software timers
  heartbeatTimer = xTimerCreate(
    "HeartbeatTimer",
    pdMS_TO_TICKS(500),
    pdTRUE, // Retriggers on end
    NULL,
    heartbeatCallback
  );

  LEDOffTimer = xTimerCreate(
    "LEDOffTimer",
    pdMS_TO_TICKS(100),
    pdFALSE, // One-shot
    NULL,
    [](TimerHandle_t xTimer) {
      digitalWrite(HRLED, LOW);
    }
  );

  // Start timers
  xTimerStart(heartbeatTimer, 0);

  // Start serial read task
  xTaskCreatePinnedToCore(
    SerialTask,     // Task function
    "SerialTask",   // Task name
    2048,           // Stack size in bytes
    NULL,           // Parameters
    1,              // Priority
    &SerialHandle,  // Task handle
    1               // Run on core 1
  );

  xTaskCreatePinnedToCore(
    HRTask,       // Task function
    "HRTask",     // Task name
    2048,         // Stack size in bytes
    NULL,         // Parameters
    3,            // Priority
    &HRHandle,    // Task handle
    1             // Run on core 1
  );

  xTaskCreatePinnedToCore(
    CuffTask,     // Task function
    "CuffTask",   // Task name
    2048,         // Stack size
    NULL,         // Parameters
    2,            // Priority
    &CuffHandle,  // Task handle
    1             // Run on core 1
  );

  xTaskCreatePinnedToCore(
    MotorTask,        // Task function
    "MotorTask",      // Task name
    4096,             // Stack size in bytes
    NULL,             // Parameters
    4,                // Priority
    &MotorHandle,     // Task handle
    1                 // Run on core 1
  );
}

void loop() {
}
